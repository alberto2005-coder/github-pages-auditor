# El archivo .env es OPCIONAL: todo puede pasarse por parámetros de consola.
# Prioridad: parámetros > variables de entorno / .env > valores por defecto.
# Copia este archivo a ".env" y rellena SOLO lo que necesites (lo vacío se ignora).

# Usuario de GitHub a auditar (equivale a -u)
USUARIO_GITHUB=

# Dominio de tus GitHub Pages (equivale a -w). Vacío = https://<usuario>.github.io
DOMINIO_WEB=

# Token de la API de GitHub (equivale a -k). OPCIONAL.
# Con token se usa la API (más fiable); sin él, el modo web. No lo subas a git.
GITHUB_TOKEN=

# Archivo del informe (equivale a -o). Vacío = paginas_github.txt
ARCHIVO_SALIDA=
